# ── 화면(브라우저)에서 쓰는 값 – VITE_ 로 시작해야 합니다 ──
# 상담 폼 전송 주소 (site.ts 의 form.endpoint 보다 우선). 예: /api/consult 또는 https://formspree.io/f/xxxx
VITE_CONSULT_ENDPOINT=

# ── 서버 함수(api/consult.ts)에서 쓰는 값 – 절대 VITE_ 를 붙이지 마세요 (외부 노출 방지) ──
# 방법 A: 웹훅
CONSULT_WEBHOOK_URL=
# 방법 B: Resend 이메일
RESEND_API_KEY=
CONSULT_TO_EMAIL=
CONSULT_FROM_EMAIL=
